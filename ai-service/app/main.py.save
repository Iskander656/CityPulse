from fastapi import FastAPI

app = FastAPI(
    title="CityPulse AI",
    description="Intelligent analysis service for the CityPulse smart city platform.",
    version="1.0.0"
)


@app.get("/")
def home():
    return {
        "application": "CityPulse AI",
        "status": "operational",
        "version": "1.0.0"
    }


@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "service": "CityPulse AI"
    }
